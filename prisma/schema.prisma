// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @default("")
  course       String?
  semester     String?
  examDate     String? // ISO date or null
  onboarded    Boolean  @default(false)
  avatarSeed   String   @default("prism")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspaces   Workspace[]
}

model Workspace {
  id            String     @id @default(cuid())
  userId        String
  name          String
  examDate      String?
  studyGoal     String?
  color         String     @default("emerald")
  learningState String     @default("{}")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources     Resource[]
  concepts      Concept[]

  @@index([userId])
}

// A source file uploaded to a workspace. The backend is the source of truth:
// files are saved to disk and their extracted text is stored here so the AI
// can read the actual material when mapping the curriculum / generating
// practice / writing theory answers.
model Resource {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  kind          String // notes | textbook | question-bank | past-paper | syllabus | photo
  status        String // parsing | parsed | ocr-low | gap
  pages         Int?
  note          String?
  sizeKb        Int?
  filePath      String? // absolute path on disk (uploads/)
  extractedText String? // the real text the AI reads — empty for scans/photos that failed OCR
  createdAt     DateTime @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// A concept in a workspace's dependency graph. Built by the AI from the
// extracted material; persisted so it survives reloads from the server.
model Concept {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String
  description  String
  unit         String
  examWeight   Float    @default(0)
  mastery      Float    @default(0)
  status       String   @default("available") // locked | available | in-progress | mastered
  dependencies String   @default("[]") // JSON array of concept ids
  hintsUsed    Int      @default(0)
  fullReveals  Int      @default(0)
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
